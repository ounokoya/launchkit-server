<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test names read as sentences (Given_When_Then) and fixtures follow xUnit naming. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1515;CA2007;CA1861;CA1052</NoWarn>
  </PropertyGroup>
</Project>
